# B5: Release keystore yapılandırma şablonu.
#
# Mağaza yayını için bu dosyayı `keystore.properties` olarak kopyalayın ve
# gerçek değerleri girin. build.gradle.kts bu dosyayı okur; dosya yoksa veya
# storeFile geçersizse release build'i güvenli fallback olarak DEBUG imzasıyla
# üretilir (CI/doğrulama amacıyla).
#
# NOT: Gerçek keystore bilgilerini asla sürüm kontrolüne (git) eklemeyin.
# keystore.properties dosyasının .gitignore'a ekli olduğundan emin olun.

storeFile=../keystore/release.keystore
storePassword=CHANGE_ME
keyAlias=release
keyPassword=CHANGE_ME
